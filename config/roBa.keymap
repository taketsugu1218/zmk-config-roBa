#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    tapping-term-ms = <120>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <120>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <2 5 9>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };
    };

    macros {
        to_win_base: to_win_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &tog 1>;
            label = "TO_WIN_BASE";
        };
    };
    behaviors {
        ht_scroll: ht_scroll {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_SCROLL";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <120>;
            bindings = <&mo>, <&mkp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Base (Mac)
        default_layer {
            bindings = <
&kp Q             &kp W     &kp E     &kp R              &kp T                                                    &kp Y      &kp U      &lt 5 I    &kp O      &kp P
&kp A             &kp S     &kp D     &kp F              &kp G      &kp LG(LS(S))                    &kp COLON    &kp H      &kp J      &kp K      &lt 2 L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X     &kp C     &kp V              &kp B      &kp LC(LS(X))                    &kp SQT      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH
&kp LCTRL         &kp LGUI  &kp LALT  &lt 6 INT_HENKAN   &lt 2 SPACE  &lt 3 INT_MUHENKAN             &kp BSPC     &lt 3 RET                                   &lt 6 DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // Layer 1: Windows (overlay)
        WINDOWS {
            bindings = <
&trans    &trans    &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans
&trans    &trans    &trans  &trans  &trans  &kp LC(LS(S))          &trans      &trans  &trans  &trans  &trans  &trans
&trans    &trans    &trans  &trans  &trans  &trans                 &trans      &trans  &trans  &trans  &trans  &trans
&kp LGUI  &kp LCTRL &trans  &trans  &trans  &trans                &trans      &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // Layer 2: NUM+FN (scroll enabled via trackball)
        NUM_FN {
            bindings = <
&kp PLUS                    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS                                                     &kp F1   &kp F2   &kp F3   &kp F4   &kp F5
&kp FSLH                    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))       &kp F13            &kp F6   &kp F7   &kp F8   &kp F9   &kp F10
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DOT       &kp EQUAL                    &trans             &trans   &trans   &trans   &trans   &kp F11
&trans                      &trans           &trans           &trans           &trans        &trans                        &trans             &trans                              &kp F12
            >;
        };

        // Layer 3: NAV+SYM
        NAV_SYM {
            bindings = <
&kp ESC         &kp LC(LS(TAB))      &kp UP     &kp LC(TAB)          &trans                                          &kp CARET  &kp AMPS   &kp TILDE  &kp LPAR   &kp RPAR
&kp HOME        &kp LEFT             &kp DOWN   &kp RIGHT            &kp END   &trans              &kp UNDERSCORE    &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT
&kp LEFT_SHIFT  &kp LG(LS(LEFT))     &trans     &kp LG(LS(RIGHT))   &trans    &trans              &trans            &kp LBKT   &kp RBKT   &kp LBRC   &kp RBRC   &kp BSLH
&trans          &trans               &trans     &trans               &trans    &trans                                &trans     &trans                            &kp PIPE
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        // Layer 4: Mouse (automouse)
        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // Layer 5: Scroll (trackball becomes scroll wheel)
        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // Layer 6: System (BT + RHO entry)
        SYSTEM {
            bindings = <
&tog 1  &trans  &trans  &trans  &trans                              &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans          &trans      &to 7         &to 8         &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans          &bootloader &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans                      &trans        &trans                                    &bt BT_CLR_ALL
            >;
        };

        // Layer 7: RHO_MAC (right hand only, Mac shortcuts)
        RHO_MAC {
            bindings = <
&none  &none  &none  &none  &none                       &kp ESC    &kp LG(Z)   &kp LC(UP)    &kp LG(TAB)    &kp LG(W)
&none  &none  &none  &none  &none  &none       &mkp MB1 &kp LC(LS(X))  &kp LC(LEFT) &kp LC(DOWN) &kp LC(RIGHT)  &kp LG(S)
&none  &none  &none  &none  &none  &none       &ht_scroll 9 MB2 &kp RET    &kp SPACE    &kp LG(C)    &kp LG(V)      &to 0
&none  &none  &none  &none  &none  &none                &kp BSPC   &kp DEL                                  &to 0
            >;
        };

        // Layer 8: RHO_WIN (right hand only, Windows shortcuts)
        RHO_WIN {
            bindings = <
&none  &none  &none  &none  &none                       &kp ESC    &kp LC(Z)    &kp LC(UP)    &kp LA(TAB)    &kp LC(W)
&none  &none  &none  &none  &none  &none       &mkp MB1 &kp LC(LS(X))  &kp LC(LEFT) &kp LC(DOWN)  &kp LC(RIGHT)  &kp LC(S)
&none  &none  &none  &none  &none  &none       &ht_scroll 9 MB2 &kp RET    &kp SPACE    &kp LC(C)     &kp LC(V)      &to_win_base
&none  &none  &none  &none  &none  &none                &kp BSPC   &kp DEL                                   &to_win_base
            >;
        };

        // Layer 9: RHO_SCROLL (MB2長押し中のスクロールモード、RHO layers用)
        RHO_SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
